NODE_ENV=development
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=billing
DB_PASS=billing
DB_NAME=billing

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Mercado Pago
# MP_MOCK=true  → usa MercadoPagoMockAdapter (obrigatório quando MP_ACCESS_TOKEN não é um token real)
MP_MOCK=true
MP_ACCESS_TOKEN=TEST-xxxx
MP_WEBHOOK_SECRET=your-webhook-secret
MP_NOTIFICATION_URL=https://your-domain.com/billing/webhook/mercadopago

# JWT (mesmo segredo do OS Service para validar tokens)
JWT_SECRET=change-me-in-production

# New Relic APM
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=autoflow-billing
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_LOG_LEVEL=info
